---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "Xüsusiyyətlər",
    path: "/#features",
  },
  {
    title: "Platformalar",
    path: "/#platforms",
  },
  {
    title: "Dəstək",
    path: "/support",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-2xl flex items-center gap-1">
          <span class="font-extrabold text-emerald-600 tracking-tight">bosq</span><span
            class="text-slate-400 font-semibold">.app</span
          >
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-5 h-5 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item) => (
              <li>
                <a
                  href={item.path}
                  class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-emerald-600 transition font-medium">
                  <span>{item.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link href="/#cta" size="md" block>Erkən Giriş</Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Tezliklə
        </span>
        <Link href="/#cta" size="md">Erkən Giriş</Link>
      </div>
    </div>
  </header>
</Container>
