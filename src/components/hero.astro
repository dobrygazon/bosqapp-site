---
import { Picture } from "astro:assets";
import heroImage from "@/assets/app-screenshot.jpg";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-12 pb-8 md:pt-16 md:pb-24 gap-12">
  <div class="py-4 flex justify-center w-full lg:order-last">
    <div class="relative mx-auto max-w-[280px] sm:max-w-[320px] lg:max-w-[340px] w-full">
      <!-- Glow effect -->
      <div
        class="absolute -inset-4 bg-gradient-to-tr from-emerald-500/20 via-amber-500/10 to-emerald-500/15 rounded-[3rem] blur-2xl -z-10">
      </div>

      <!-- Phone frame -->
      <div
        class="relative bg-slate-900 p-2.5 sm:p-3 rounded-[2.8rem] sm:rounded-[3rem] shadow-2xl shadow-slate-900/30 border-4 border-slate-800">
        <!-- Screen container -->
        <div class="overflow-hidden rounded-[2.2rem] sm:rounded-[2.4rem] bg-stone-50">
          <Picture
            src={heroImage}
            alt="bosq tətbiqinin interfeysi — Süni intellektli kalori və makro izləyicisi"
            widths={[320, 640]}
            sizes="(max-width: 640px) 280px, 340px"
            loading="eager"
            class="w-full h-auto block"
          />
        </div>
      </div>
    </div>
  </div>
  <div>
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 mb-6">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      🇦🇿 Azərbaycanın İlk Süni İntellektli Qida Skaneri
    </div>
    <h1
      class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      Boşqabının şəklini çək, qalanını <span class="text-emerald-600">bosq</span>-a burax.
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl leading-relaxed">
      Tərəzidə qram-qram çəkməyə və cədvəllərdə axtarmağa son. Plov, dolma, qutab və ya salat — sadəcə fotosunu çək, bosq saniyələr içində kaloriləri, zülalları, yağları və karbohidratları hesablasın.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link
        href="/#cta"
        class="flex gap-2 items-center justify-center">
        <Icon class="text-white w-5 h-5" name="bx:bxs-zap" />
        Erkən Giriş Qazan
      </Link>
      <Link
        size="lg"
        style="outline"
        href="/#features"
        class="flex gap-2 items-center justify-center">
        <Icon class="text-black w-4 h-4" name="bx:bxs-dish" />
        Xüsusiyyətlər
      </Link>
    </div>
  </div>
</main>
