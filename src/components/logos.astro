---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div class="mt-24" id="platforms">
  <h2 class="text-center text-slate-500 font-medium">Tezliklə sevdiyiniz mobil platformalarda</h2>
  <div class="flex gap-8 md:gap-20 items-center justify-center mt-10 flex-wrap text-slate-700">
    <div class="flex items-center gap-3 font-semibold text-lg hover:text-black transition">
      <Icon class="size-8 md:size-10 text-black" name="simple-icons:apple" />
      <span>iOS (App Store)</span>
    </div>
    <div class="flex items-center gap-3 font-semibold text-lg hover:text-black transition">
      <Icon class="size-8 md:size-10 text-emerald-600" name="simple-icons:googleplay" />
      <span>Android (Google Play)</span>
    </div>
    <div class="flex items-center gap-3 font-semibold text-lg hover:text-black transition">
      <Icon class="size-8 md:size-10 text-green-500" name="simple-icons:android" />
      <span>APK Birbaşa Yükləmə</span>
    </div>
  </div>
</div>
