---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Customer Support & Contact Operator"
  lang="en-GB"
  description="Boşqapp Customer Support for App Store and Google Play. Contact operator Ramil Gasanov directly via email at gasanoff.ramil@gmail.com or WhatsApp at +994103237165.">
  <Container>
    <div class="max-w-4xl mx-auto py-10 sm:py-16">
      <!-- Breadcrumb / Back Link -->
      <div class="mb-8 flex items-center justify-between">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-emerald-600 hover:text-emerald-700 transition">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Home
        </a>
        <a
          href="/privacy"
          class="text-xs sm:text-sm font-medium text-slate-500 hover:text-emerald-600 transition">
          Privacy Policy &rarr;
        </a>
      </div>

      <!-- Main Support Container -->
      <div class="bg-white border border-slate-200/80 rounded-2xl p-6 sm:p-10 md:p-12 shadow-xs">
        <!-- Header -->
        <header class="border-b border-slate-200 pb-8 mb-8">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Official Customer Support
            </span>
            <span
              class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">
              English (U.K.) Store Listing
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            How Can We Help You?
          </h1>
          <p class="text-base sm:text-lg text-slate-600 mt-3 leading-relaxed">
            Welcome to the official support portal for <strong>Boşqapp</strong>. Whether you need technical assistance, have questions regarding your account or in-app subscription, or wish to report a bug, you can reach the app operator directly through the channels below.
          </p>
        </header>

        <!-- Direct Contact Channels -->
        <section class="mb-12">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-2">
            Direct Contact with the Operator
          </h2>
          <p class="text-sm sm:text-base text-slate-600 mb-6">
            Our support desk is directly managed by the operator. We typically respond within 24 hours.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Email Support Card -->
            <div
              class="relative flex flex-col justify-between p-6 rounded-2xl border-2 border-slate-200 hover:border-emerald-500 bg-slate-50/50 hover:bg-emerald-50/20 transition group">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div
                    class="w-12 h-12 rounded-xl bg-emerald-600 text-white flex items-center justify-center shadow-xs">
                    <!-- Mail Icon -->
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-6 h-6"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 bg-emerald-100/70 px-2.5 py-1 rounded-md">
                    Email Support
                  </span>
                </div>

                <h3 class="text-lg font-bold text-slate-900 mb-1">Send an Email</h3>
                <p class="text-sm text-slate-600 mb-4">
                  Best for detailed queries, account assistance, subscription inquiries, and bug reports.
                </p>

                <div class="bg-white border border-slate-200 rounded-lg p-3 mb-4 flex items-center justify-between">
                  <a
                    href="mailto:gasanoff.ramil@gmail.com?subject=Bo%C5%9Fqapp%20Support%20Enquiry"
                    class="font-mono text-xs sm:text-sm text-emerald-700 hover:underline font-semibold break-all">
                    gasanoff.ramil@gmail.com
                  </a>
                  <button
                    type="button"
                    class="copy-btn text-xs text-slate-500 hover:text-slate-800 ml-2 p-1.5 hover:bg-slate-100 rounded transition shrink-0 inline-flex items-center gap-1"
                    data-copy="gasanoff.ramil@gmail.com"
                    title="Copy Email Address">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                    <span>Copy</span>
                  </button>
                </div>
              </div>

              <div class="mt-2">
                <a
                  href="mailto:gasanoff.ramil@gmail.com?subject=Bo%C5%9Fqapp%20Support%20Enquiry"
                  class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-sm transition shadow-xs">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                  </svg>
                  Email Support Team
                </a>
              </div>
            </div>

            <!-- WhatsApp Support Card -->
            <div
              class="relative flex flex-col justify-between p-6 rounded-2xl border-2 border-slate-200 hover:border-emerald-500 bg-slate-50/50 hover:bg-emerald-50/20 transition group">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div
                    class="w-12 h-12 rounded-xl bg-[#25D366] text-white flex items-center justify-center shadow-xs">
                    <!-- WhatsApp Icon -->
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-6 h-6 fill-current"
                      viewBox="0 0 24 24">
                      <path
                        d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                    </svg>
                  </div>
                  <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 bg-emerald-100/70 px-2.5 py-1 rounded-md">
                    Instant Messaging
                  </span>
                </div>

                <h3 class="text-lg font-bold text-slate-900 mb-1">WhatsApp Chat</h3>
                <p class="text-sm text-slate-600 mb-4">
                  Direct live messaging with the operator for fast troubleshooting and quick questions.
                </p>

                <div class="bg-white border border-slate-200 rounded-lg p-3 mb-4 flex items-center justify-between">
                  <a
                    href="https://wa.me/994103237165?text=Hello%20Bo%C5%9Fqapp%20Support"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-xs sm:text-sm text-emerald-700 hover:underline font-semibold">
                    +994 10 323 71 65
                  </a>
                  <button
                    type="button"
                    class="copy-btn text-xs text-slate-500 hover:text-slate-800 ml-2 p-1.5 hover:bg-slate-100 rounded transition shrink-0 inline-flex items-center gap-1"
                    data-copy="+994103237165"
                    title="Copy Phone Number">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                    <span>Copy</span>
                  </button>
                </div>
              </div>

              <div class="mt-2">
                <a
                  href="https://wa.me/994103237165?text=Hello%20Bo%C5%9Fqapp%20Support"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-[#25D366] hover:bg-[#20ba59] text-white font-medium text-sm transition shadow-xs">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4 fill-current"
                    viewBox="0 0 24 24">
                    <path
                      d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                  </svg>
                  Chat on WhatsApp
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- Frequently Asked Questions (Store Reviewer & Customer Friendly) -->
        <section class="border-t border-slate-200 pt-10">
          <h2 class="text-2xl font-bold text-slate-900 mb-2">
            Frequently Asked Questions
          </h2>
          <p class="text-sm sm:text-base text-slate-600 mb-8">
            Find answers to common questions about Boşqapp, your subscription, and data security.
          </p>

          <div class="space-y-6">
            <!-- Question 1 -->
            <div class="bg-slate-50/70 border border-slate-200 rounded-xl p-5 sm:p-6">
              <h3 class="text-base sm:text-lg font-bold text-slate-900 mb-2">
                How do I manage, cancel, or restore my in-app subscription?
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-3">
                All subscriptions and billing are processed directly and securely by Apple via App Store In-App Purchases (StoreKit).
              </p>
              <ul class="text-sm text-slate-600 list-disc list-inside space-y-1.5 ml-1">
                <li>
                  <strong>To Cancel or Change Plans:</strong> Open your iPhone's <strong>Settings</strong> app &gt; tap your <strong>Apple ID name</strong> at the top &gt; tap <strong>Subscriptions</strong> &gt; choose <strong>Boşqapp</strong> &gt; tap <strong>Cancel Subscription</strong>.
                </li>
                <li>
                  <strong>To Restore Purchases:</strong> Open Boşqapp &gt; go to <strong>Profile</strong> &gt; tap <strong>Subscription</strong> &gt; select <strong>Restore Purchases</strong>.
                </li>
              </ul>
            </div>

            <!-- Question 2 -->
            <div class="bg-slate-50/70 border border-slate-200 rounded-xl p-5 sm:p-6">
              <h3 class="text-base sm:text-lg font-bold text-slate-900 mb-2">
                How can I permanently delete my account and data?
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-3">
                You have the full right to erasure at any time:
              </p>
              <ol class="text-sm text-slate-600 list-decimal list-inside space-y-1.5 ml-1">
                <li>Open <strong>Boşqapp</strong> on your device.</li>
                <li>Navigate to <strong>Profile</strong> &gt; <strong>Settings</strong>.</li>
                <li>Tap <strong>Delete Account</strong> and confirm your choice.</li>
              </ol>
              <p class="text-xs text-slate-500 mt-3 leading-relaxed">
                When confirmed, your profile record, personal dietary targets, all meal images, and your entire food log history are immediately and irreversibly purged from our servers. You may also email <a href="mailto:gasanoff.ramil@gmail.com" class="text-emerald-600 underline">gasanoff.ramil@gmail.com</a> to request manual erasure.
              </p>
            </div>

            <!-- Question 3 -->
            <div class="bg-slate-50/70 border border-slate-200 rounded-xl p-5 sm:p-6">
              <h3 class="text-base sm:text-lg font-bold text-slate-900 mb-2">
                How does AI food scanning work and how accurate is it?
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Boşqapp uses high-accuracy visual recognition models trained with specific understanding of regional Azerbaijani and international home-cooked dishes (e.g. plov, dolma, qutab, dovğa). After capturing a photo, our system estimates calories and macronutrients (protein, carbs, fat). You can always tap on any scan to adjust portions or refine ingredients manually before saving.
              </p>
            </div>

            <!-- Question 4 -->
            <div class="bg-slate-50/70 border border-slate-200 rounded-xl p-5 sm:p-6">
              <h3 class="text-base sm:text-lg font-bold text-slate-900 mb-2">
                What should I do if a meal photo fails to scan?
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Ensure you have an active internet connection (Wi-Fi or cellular data) and adequate lighting on the dish. If an error persists, you can use the "Re-scan" option or type the dish name manually. If issues persist, please message us on WhatsApp (+994 10 323 71 65) or send an email with the screenshot.
              </p>
            </div>

            <!-- Question 5 -->
            <div class="bg-slate-50/70 border border-slate-200 rounded-xl p-5 sm:p-6">
              <h3 class="text-base sm:text-lg font-bold text-slate-900 mb-2">
                Where can I review the Boşqapp Privacy Policy?
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Our full Privacy Policy detailing data protection practices, encryption standards, and third-party infrastructure providers is accessible at any time at <a href="/privacy" class="text-emerald-600 underline font-semibold">https://bosq.app/privacy</a>.
              </p>
            </div>
          </div>
        </section>

        <!-- Footer note -->
        <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
          <p>
            © {new Date().getFullYear()} Boşqapp. Maintained by operator Ramil Gasanov.
          </p>
          <div class="flex items-center gap-4">
            <a href="/privacy" class="hover:text-emerald-600 underline">Privacy Policy</a>
            <span>•</span>
            <a href="/" class="hover:text-emerald-600 underline">Home Page</a>
          </div>
        </div>
      </div>
    </div>
  </Container>

  <!-- Client-side script for copy-to-clipboard functionality with feedback -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const copyButtons = document.querySelectorAll(".copy-btn");
      copyButtons.forEach((btn) => {
        btn.addEventListener("click", async () => {
          const textToCopy = btn.getAttribute("data-copy");
          if (!textToCopy) return;

          try {
            await navigator.clipboard.writeText(textToCopy);
            const originalContent = btn.innerHTML;
            btn.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-emerald-700 font-semibold">Copied!</span>
            `;
            setTimeout(() => {
              btn.innerHTML = originalContent;
            }, 2000);
          } catch (err) {
            console.error("Failed to copy:", err);
          }
        });
      });
    });
  </script>
</Layout>
